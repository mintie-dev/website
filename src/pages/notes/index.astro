---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, fmtDay } from '../../lib/util';

// Drafts are listed but greyed out and not clickable, like unfinished projects.
const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Notes">
  <h1>Notes</h1>
  <p class="muted">Things I care about, things I'm learning, and half-formed thoughts.</p>
  <ul class="entries">
    {notes.map((n) => {
      const head = (
        <div class="entry-row">
          <span class="title">{n.data.title}</span>
          <span class="date">{fmtDay(n.data.date)}</span>
        </div>
      );
      return (
        <li class:list={{ inactive: n.data.draft }}>
          {n.data.draft ? head : (
            <a class="card" href={url(`/notes/${n.id}`)}>
              {head}
              {n.data.summary && <div class="summary">{n.data.summary}</div>}
            </a>
          )}
        </li>
      );
    })}
  </ul>
</Base>
