---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Envelope from '../components/Envelope.astro';
import { url } from '../lib/util';

// Three vertical (9:16) final-demo clips. Set `id` to a project file name and `video` to its clip;
// leave a slot as null to show a placeholder.
const highlightSlots = [
  { id: 'nush-hack-2023-duster', video: '/assets/nushhack_10nov23/final_demo.MP4' },
  { id: 'urop-visual-grip-force', video: '/assets/urop_force/demo-vertical.mp4' },
  { id: 'rb2301-astar-pid', video: '/assets/rb2301_ca2/demo-vertical.mp4' },
];
const highlights = await Promise.all(
  highlightSlots.map(async (h) => (h ? { ...h, project: (await getEntry('projects', h.id))! } : null)),
);
---
<Base>
  <p class="contacts">
    <a href="https://x.com/lmtuwu">X (Twitter)</a>{' · '}
    <a href="https://www.linkedin.com/in/le-mai-thi/">LinkedIn</a>{' · '}
    <a href="mailto:lemaithi0203@gmail.com">Gmail</a>{' · '}
    <a href="https://t.me/lmthi">Telegram</a>{' · '}
    <a href="https://www.instagram.com/lmt.uwu/">Instagram</a>
  </p>

  <div class="intro">
  <img id="intro-photo" src={url('/assets/about/me.webp')} alt="Thi hugging a giant Hello Kitty statue" />
  <div class="intro-text" id="intro-text">
  <p>
    Hello, world! I'm Le Mai Thi, but you can call me Thi, pronounced /tee/. I study Robotics &amp; Machine
    Intelligence (RMI) at the National University of Singapore (NUS). I spend most of my time on
    robotics: building things, researching, and figuring out what I don't understand yet.
  </p>
  <p>
    If you have something to tell me but would rather not use the links above, drop me a message <a class="letter-link" id="letter-link" href={url('/writealetter')} title="Write me a letter">here<span class="letter-drop" id="letter-drop" aria-hidden="true"><svg class="loop-arrow" width="100" height="67" viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2 C0 20 2 40 16 46 C30 52 48 46 48 36 C48 26 34 26 30 36 C26 48 40 62 62 63 C78 64 92 61 104 57" stroke-dasharray="4.5 4" /><path d="M96.2 55.4 L104 57 L98.7 63" /></svg><Envelope /></span></a>.
  </p>
  </div>
  </div>
  <script is:inline>
    // Match the photo's height to the intro text beside it (side-by-side layout only).
    (() => {
      const img = document.getElementById('intro-photo');
      const text = document.getElementById('intro-text');
      const stacked = matchMedia('(max-width: 520px)');
      const fit = () => {
        if (stacked.matches) { img.style.height = img.style.width = ''; return; }
        img.style.height = text.offsetHeight + 'px';
        img.style.width = 'auto';
      };
      // the arrow + envelope hang below "here."; nudge them left if they'd run past the column
      const drop = document.getElementById('letter-drop');
      const keepInside = () => {
        drop.style.translate = '';
        const over = drop.getBoundingClientRect().right - text.getBoundingClientRect().right;
        if (over > 0) drop.style.translate = `${-over}px 0`;
      };
      new ResizeObserver(() => { fit(); keepInside(); }).observe(text);
      stacked.addEventListener('change', fit);
    })();
  </script>

  <script>
    // Open envelope with a letter peeking out while there are letters in the mailbox.
    import { getStatus } from '../lib/mailbox';
    getStatus().then((s) => {
      if (!s || s.count === 0) return;
      const env = document.querySelector('#letter-link .env');
      env?.classList.replace('is-closed', 'is-open');
    });
  </script>

  <div class="section-head">
    <h2>Highlights</h2>
    <a class="small" href={url('/projects')}>see all</a>
  </div>
  <div class="highlights">
    {highlights.map((h) =>
      h ? (
        <a href={url(`/projects/${h.project.id}`)}>
          <div class="reel">
            <video src={h.video} autoplay muted loop playsinline preload="metadata"></video>
          </div>
          <div class="caption">{h.project.data.title}</div>
        </a>
      ) : (
        <div class="placeholder">
          <div class="reel">coming soon</div>
          <div class="caption">Project title</div>
        </div>
      ),
    )}
  </div>

</Base>
