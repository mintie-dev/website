---
import type { CollectionEntry } from 'astro:content';
import { FIELDS } from '../content.config';
import { url, hasPage, fmtMonth, TOPIC_TAGS } from '../lib/util';

interface Props { projects: CollectionEntry<'projects'>[] }
// Coming soon first, then ongoing, then finished projects newest first.
const STATUS_ORDER = { planned: 0, ongoing: 1, done: 2 };
const projects = [...Astro.props.projects].sort(
  (a, b) =>
    STATUS_ORDER[a.data.status] - STATUS_ORDER[b.data.status] || b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<div class="filters" id="filters" hidden>
  <div><span class="label">field</span>
    <button data-value="" aria-pressed="true">all</button>
    {FIELDS.map((f) => <button data-value={f} aria-pressed="false">{f}</button>)}
  </div>
</div>

<ul class="entries" id="project-list">
  {projects.map((p) => {
    const badge = { ongoing: 'ongoing', planned: 'soon' }[p.data.status as string];
    const head = (
      <div class="entry-row">
        <span class="title">{badge && <span class={`badge badge-${p.data.status}`}>{badge}</span>}{p.data.title}</span>
        {p.data.status === 'done' && <span class="date">{fmtMonth(p.data.date)}</span>}
      </div>
    );
    return (
      <li data-field={p.data.fields.join(' ')} class:list={{ inactive: !hasPage(p), [p.data.status]: true }}>
        {hasPage(p) ? (
          <a class="card" href={url(`/projects/${p.id}`)}>
            {head}
            <div class="summary">
              {p.data.summary}
              {p.data.topics.map((t) => <> <span class="tag">{TOPIC_TAGS[t]}</span></>)}
            </div>
          </a>
        ) : head}
      </li>
    );
  })}
</ul>

<script>
  const filters = document.getElementById('filters')!;
  const items = [...document.getElementById('project-list')!.children] as HTMLElement[];

  filters.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const field = btn.dataset.value!;
    filters.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    for (const li of items) li.hidden = !!field && !li.dataset.field!.split(' ').includes(field);
  });

  filters.hidden = false;
</script>
