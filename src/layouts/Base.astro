---
import '../styles/global.css';
import { url } from '../lib/util';

interface Props { title?: string; description?: string }
const { title, description = 'Le Mai Thi: Robotics & Machine Intelligence at NUS' } = Astro.props;
const fullTitle = title ? `${title} — Le Mai Thi` : 'Le Mai Thi';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link-preview image (Telegram, WhatsApp, X, etc.): the About page highlights.
const ogImage = new URL('/og-card-2.jpg', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const section = path === '/' ? '/' : '/' + path.split('/')[1];
const links = [
  { href: '/', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
];
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le Mai Thi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Le Mai Thi, /leh-maɪ-tiː/. Documenting my Robotics Projects." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <!-- Google search results need a square icon sized in multiples of 48px -->
    <link rel="icon" href={url('/favicon-48.png')} sizes="48x48" type="image/png" />
    <link rel="icon" href={url('/favicon-96.png')} sizes="96x96" type="image/png" />
    <link rel="icon" href={url('/favicon-192.png')} sizes="192x192" type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Le Mai Thi',
      url: 'https://lemaithi.com/',
    })} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <script is:inline>
      // Light by default; apply a saved choice before paint to avoid a flash.
      try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a class="name" href={url('/')}>Le Mai Thi</a>
        {links.map((l) => (
          <a href={url(l.href)} aria-current={section === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </nav>
      <script is:inline>
        document.getElementById('theme-toggle').addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        });
      </script>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>Updated {built}</span>
      <button class="to-top" id="to-top" type="button">back to top</button>
    </footer>
    <script is:inline>
      (() => {
        const header = document.querySelector('header');
        const toTop = document.getElementById('to-top');
        let last = scrollY;
        const onScroll = () => {
          const y = scrollY;
          header.classList.toggle('scrolled', y > 0);
          // Stay visible for the first stretch, then tuck away going down and return going up.
          if (y > last && y > 160) header.classList.add('tucked');
          else if (y < last - 4 || y <= 160) header.classList.remove('tucked');
          last = y;
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
      })();
    </script>
  </body>
</html>
